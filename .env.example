# 复制为 .env 并填入真实 key
# 无网环境建议开启：跳过所有联网探测，问答/同步立即走本地逻辑
APP_OFFLINE=0                  # 改成 1 即声明离线（离线使用推荐）

LLM_PROVIDER=deepseek          # deepseek / bailian / doubao
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备用模型（主模型故障时切换）
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
